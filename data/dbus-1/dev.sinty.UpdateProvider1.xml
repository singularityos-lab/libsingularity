<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node name="/dev/sinty/UpdateProvider1">
  <interface name="dev.sinty.UpdateProvider1">
    <property name="Name" type="s" access="read"/>
    <property name="CurrentVersion" type="s" access="read"/>
    <property name="State" type="s" access="read"/>
    <property name="AvailableVersion" type="s" access="read"/>
    <property name="ReleaseNotes" type="s" access="read"/>
    <property name="DownloadSize" type="t" access="read"/>
    <property name="Progress" type="d" access="read"/>
    <property name="LastError" type="s" access="read"/>
    <property name="LastCheck" type="x" access="read"/>
    <property name="Capabilities" type="as" access="read"/>
    <method name="Check"/>
    <method name="Download"/>
    <method name="Schedule"/>
    <method name="Unschedule"/>
    <method name="GetHistory">
      <arg name="entries" type="a(sxbs)" direction="out"/>
    </method>
  </interface>
</node>
