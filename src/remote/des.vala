        };

        private uint64 subkeys[16];

        private static uint64 permute (uint64 input, uint8[] table, int in_bits) {
            uint64 output = 0;
            foreach (uint8 pos in table) {
                output = (output << 1) | ((input >> (in_bits - pos)) & 1);
            }
            return output;
        }

        public Des (uint8[] key) {
            uint64 k = 0;
            for (int i = 0; i < 8; i++) k = (k << 8) | key[i];
            uint64 cd = permute (k, PC1, 64);
            uint32 c = (uint32) ((cd >> 28) & 0xFFFFFFF);
            uint32 d = (uint32) (cd & 0xFFFFFFF);
            for (int i = 0; i < 16; i++) {
                for (int s = 0; s < SHIFTS[i]; s++) {
                    c = ((c << 1) | (c >> 27)) & 0xFFFFFFF;
                    d = ((d << 1) | (d >> 27)) & 0xFFFFFFF;
                }
                subkeys[i] = permute (((uint64) c << 28) | d, PC2, 56);
            }
        }

        private static uint32 feistel (uint32 r, uint64 subkey) {
            uint64 x = permute (r, E, 32) ^ subkey;
            uint32 acc = 0;
            for (int i = 0; i < 8; i++) {
                int six = (int) ((x >> (42 - 6 * i)) & 0x3F);
                int row = ((six & 0x20) >> 4) | (six & 1);
                int col = (six >> 1) & 0xF;
                acc = (acc << 4) | S[i * 64 + row * 16 + col];
            }
            return (uint32) permute (acc, P, 32);
        }

        public uint8[] encrypt_block (uint8[] block) {
            uint64 b = 0;
            for (int i = 0; i < 8; i++) b = (b << 8) | block[i];
            b = permute (b, IP, 64);
            uint32 l = (uint32) (b >> 32);
            uint32 r = (uint32) b;
            for (int i = 0; i < 16; i++) {
                uint32 t = r;
                r = l ^ feistel (r, subkeys[i]);
                l = t;
            }
            b = permute (((uint64) r << 32) | l, FP, 64);
            var result = new uint8[8];
            for (int i = 7; i >= 0; i--) {
                result[i] = (uint8) (b & 0xFF);
                b >>= 8;
            }
            return result;
        }

        private static uint8 reverse_bits (uint8 v) {
            uint8 r = 0;
            for (int i = 0; i < 8; i++) {
                r = (r << 1) | (v & 1);
                v >>= 1;
            }
            return r;
        }

        public static uint8[] vnc_response (string password, uint8[] challenge) {
            var key = new uint8[8];
            unowned uint8[] pw = password.data;
            for (int i = 0; i < 8; i++) key[i] = i < pw.length ? reverse_bits (pw[i]) : 0;
            var des = new Des (key);
            var response = new uint8[16];
            var first = des.encrypt_block (challenge[0:8]);
            var second = des.encrypt_block (challenge[8:16]);
            for (int i = 0; i < 8; i++) {
                response[i] = first[i];
                response[i + 8] = second[i];
            }
            return response;
        }
    }
}
